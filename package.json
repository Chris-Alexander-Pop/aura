{
  "name": "ags-config",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "build:css": "tailwindcss -i ./style/input.css -o ./style/style.css",
    "watch:css": "tailwindcss -i ./style/input.css -o ./style/style.css --watch",
    "watch": "concurrently \"bun run watch:css\" \"ags run app.ts\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tailwindcss": "^3.4.1",
    "bun-types": "latest"
  },
  "prettier": {
    "semi": false,
    "tabWidth": 2
  }
}
