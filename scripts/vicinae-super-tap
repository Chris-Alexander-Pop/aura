#!/usr/bin/env bash
# Super-alone tap → vicinae toggle.
#
# Bound as SUPER_L / SUPER_R with ignore_mods (no SUPER+ prefix). SUPER+code:133
# never matched a tap on Hyprland 0.56. Other keys before Super-up cancel the tap.
set -euo pipefail

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/vicinae-super-tap"
mkdir -p "$RUNTIME"
INTERRUPTED="$RUNTIME/interrupted"
WATCHER_PID="$RUNTIME/watcher.pid"
WATCHER_PY="$RUNTIME/watcher.py"
LOG="${VICINAE_TAP_LOG:-$RUNTIME/tap.log}"

log() {
  printf '%s %s\n' "$(date '+%H:%M:%S')" "$*" >>"$LOG"
}

write_watcher() {
  cat >"$WATCHER_PY" <<'PY'
import os, struct, select, sys

INTERRUPTED = sys.argv[1]
candidates = [
    "/dev/input/by-path/platform-i8042-serio-0-event-kbd",
]
by_id = "/dev/input/by-id"
if os.path.isdir(by_id):
    for name in sorted(os.listdir(by_id)):
        if name.endswith("-event-kbd"):
            candidates.append(os.path.join(by_id, name))
by_path = "/dev/input/by-path"
if os.path.isdir(by_path):
    for name in sorted(os.listdir(by_path)):
        if name.endswith("-event-kbd"):
            candidates.append(os.path.join(by_path, name))

EV_KEY = 1
KEY_LEFTMETA, KEY_RIGHTMETA = 125, 126
EVENT_SIZE = struct.calcsize("llHHi")

fds = []
seen = set()
for path in candidates:
    try:
        real = os.path.realpath(path)
        if real in seen:
            continue
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        seen.add(real)
        fds.append(fd)
    except OSError:
        continue
if not fds:
    sys.exit(0)

def mark():
    try:
        with open(INTERRUPTED, "w") as f:
            f.write("1\n")
    except OSError:
        pass

try:
    while True:
        r, _, _ = select.select(fds, [], [], 2.0)
        if not r:
            mark()
            break
        for fd in r:
            data = os.read(fd, EVENT_SIZE * 64)
            if not data:
                continue
            for i in range(0, len(data) // EVENT_SIZE * EVENT_SIZE, EVENT_SIZE):
                _sec, _usec, etype, code, value = struct.unpack_from("llHHi", data, i)
                if etype != EV_KEY:
                    continue
                if code in (KEY_LEFTMETA, KEY_RIGHTMETA):
                    if value == 0:
                        raise SystemExit(0)
                    continue
                if value == 1:
                    mark()
                    raise SystemExit(0)
finally:
    for fd in fds:
        os.close(fd)
PY
}

stop_watcher() {
  if [[ -f "$WATCHER_PID" ]]; then
    local pid
    pid=$(cat "$WATCHER_PID" 2>/dev/null || true)
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
    rm -f "$WATCHER_PID"
  fi
}

case "${1:-}" in
  press)
    stop_watcher
    echo 0 >"$INTERRUPTED"
    write_watcher
    python3 "$WATCHER_PY" "$INTERRUPTED" &
    echo $! >"$WATCHER_PID"
    log "press watcher=$!"
    ;;
  release)
    sleep 0.03
    stop_watcher
    interrupted=$(cat "$INTERRUPTED" 2>/dev/null || echo 1)
    rm -f "$INTERRUPTED"
    log "release interrupted=${interrupted}"
    if [[ "$interrupted" != "0" ]]; then
      exit 0
    fi
    now=$(date +%s%3N)
    last=$(cat "$RUNTIME/last-toggle" 2>/dev/null || echo 0)
    if [[ "$now" =~ ^[0-9]+$ && "$last" =~ ^[0-9]+$ ]] && (( now - last < 300 )); then
      log "debounce skip dt=$((now - last))"
      exit 0
    fi
    echo "$now" >"$RUNTIME/last-toggle"
    log "toggle"
    exec vicinae toggle
    ;;
  *)
    echo "usage: $0 press|release" >&2
    exit 2
    ;;
esac
