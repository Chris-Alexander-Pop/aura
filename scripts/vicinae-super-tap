#!/usr/bin/env bash
# Super-alone tap → vicinae toggle.
#
# Hyprland 0.56 keybind rewrite (#15568) breaks SUPER_L / SUPER_R sided-mod
# binds; keycodes still work. Wired from Aura Lua:
#   ~/.config/ags/hypr/hyprland/keybinds.lua
#
# A short-lived evdev watcher marks the tap interrupted if any other key is
# pressed before Super is released, so Super+A etc. do not open the launcher.
set -euo pipefail

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/vicinae-super-tap"
mkdir -p "$RUNTIME"
INTERRUPTED="$RUNTIME/interrupted"
WATCHER_PID="$RUNTIME/watcher.pid"
WATCHER_PY="$RUNTIME/watcher.py"

write_watcher() {
  cat >"$WATCHER_PY" <<'PY'
import os, struct, select, sys

INTERRUPTED = sys.argv[1]
# Prefer the AT keyboard; fall back to by-path
candidates = [
    "/dev/input/by-path/platform-i8042-serio-0-event-kbd",
]
by_id = "/dev/input/by-id"
if os.path.isdir(by_id):
    for name in sorted(os.listdir(by_id)):
        if name.endswith("-event-kbd"):
            candidates.append(os.path.join(by_id, name))

EV_KEY, EV_SYN = 1, 0
KEY_LEFTMETA, KEY_RIGHTMETA = 125, 126
EVENT_SIZE = struct.calcsize("llHHi")

fd = None
for path in candidates:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        break
    except OSError:
        continue
if fd is None:
    sys.exit(0)

def mark():
    try:
        with open(INTERRUPTED, "w") as f:
            f.write("1\n")
    except OSError:
        pass

try:
    while True:
        r, _, _ = select.select([fd], [], [], 2.0)
        if not r:
            # Super held >2s without other keys — treat as not a tap
            mark()
            break
        data = os.read(fd, EVENT_SIZE * 64)
        if not data:
            break
        for i in range(0, len(data) // EVENT_SIZE * EVENT_SIZE, EVENT_SIZE):
            _sec, _usec, etype, code, value = struct.unpack_from("llHHi", data, i)
            if etype != EV_KEY:
                continue
            if code in (KEY_LEFTMETA, KEY_RIGHTMETA):
                if value == 0:  # Super released
                    raise SystemExit(0)
                continue
            if value == 1:  # other key pressed
                mark()
                raise SystemExit(0)
finally:
    os.close(fd)
PY
}

stop_watcher() {
  if [[ -f "$WATCHER_PID" ]]; then
    local pid
    pid=$(cat "$WATCHER_PID" 2>/dev/null || true)
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
    rm -f "$WATCHER_PID"
  fi
}

case "${1:-}" in
  press)
    stop_watcher
    echo 0 >"$INTERRUPTED"
    write_watcher
    python3 "$WATCHER_PY" "$INTERRUPTED" &
    echo $! >"$WATCHER_PID"
    ;;
  release)
    # Let the watcher observe the Super release / any late key first
    sleep 0.02
    stop_watcher
    local_interrupted=$(cat "$INTERRUPTED" 2>/dev/null || echo 1)
    rm -f "$INTERRUPTED"
    if [[ "$local_interrupted" == "0" ]]; then
      exec vicinae toggle
    fi
    ;;
  *)
    echo "usage: $0 press|release" >&2
    exit 2
    ;;
esac
