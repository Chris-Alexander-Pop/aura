#!/usr/bin/env bash
# aura-launch — called by Super+Shift+A keybind

# Ensure full user PATH is present (foot/Hyprland exec may inherit a minimal PATH)
export PATH="$HOME/.bun/bin:$HOME/.cargo/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

# Kill Quickshell/Caelestia (process is named 'qs')
killall qs quickshell caelestia 2>/dev/null || true
sleep 0.3

# Visual feedback
notify-send "Aura" "⚡ Launching Aura shell..." \
    --urgency=normal \
    --expire-time=4000 \
    2>/dev/null || true

# Launch in foot terminal so build output is visible
exec foot --title "Aura Launcher" bash -c "export PATH=\"$HOME/.bun/bin:$HOME/.cargo/bin:$HOME/.local/bin:/usr/local/bin:\$PATH\"; ~/.config/ags/aura; echo; echo 'Aura exited. Press Enter to close.'; read"
