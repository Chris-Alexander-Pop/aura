+void CDialog::syncWindowHeight() {
+    if (!m_window || m_baseHeight <= 0)
+        return;
+
+    constexpr double STATUS_LINE = 18.0;
+    constexpr double STATUS_GAP  = 2.0;
+    int              lines       = 0;
+    if (m_infoShown)
+        ++lines;
+    if (m_errShown)
+        ++lines;
+    if (m_capsShown)
+        ++lines;
+
+    const double extra = lines > 0 ? STATUS_GAP + (double)lines * (STATUS_LINE + STATUS_GAP) : 0.0;
+    m_window->setSize({m_windowWidth, m_baseHeight + extra});
 }
 
